{
    "compilerOptions": {
        "composite": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "target": "ESNext",
        "jsx": "preserve",
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/renderer/*"
            ]
        },
        "outDir": "./out",
        "skipLibCheck": true
    },
    "include": [
        "src/renderer/**/*",
        "src/renderer/**/*.vue"
    ]
}